// Cloudflare Workers static-assets deploy for the Omaya API docs.
// docs.omayacare.com (prod, main specs) and docs-staging.omayacare.com
// (staging specs) are two Workers from this one config: `--env staging`.
//
// NEVER attach a route or enable workers.dev before the Cloudflare Access
// application covers the hostname — every file in dist/ is the full API
// spec, readable by anyone who reaches the Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omaya-api-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Blume writes <route>/index.html and links without a trailing slash;
    // the default (auto-trailing-slash) would 307 every page.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "omaya-api-docs-staging"
    }
  }
}
